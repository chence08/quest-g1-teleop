# Copy to config/local.env (ignored by Git). Plain KEY=VALUE, not shell commands.
# Ethernet workstation address reachable by Quest; regenerate certificates for it.
HOST_LAN_IP=192.168.1.100
G1_SSH_HOST=g1
G1_REMOTE_ROOT=/home/unitree/quest-g1-teleop
# Robot-side Python 3.10+ with SDK2 and NumPy, not the workstation env/.
G1_ROBOT_PYTHON=python3
G1_CAMERA_PYTHON=python3
G1_ARM_INTERFACE=enP8p1s0
G1_HAND_INTERFACE=lo
G1_DDS_NAMESPACE=inspire_teleop
